{
	"name": "drizzle-orm-d1-benchmark",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"bench": "node scripts/bench.mjs",
		"build:client": "node scripts/build-client.mjs",
		"dev": "pnpm run build:client && wrangler dev",
		"deploy": "pnpm run build:client && wrangler deploy",
		"dry-run": "pnpm run build:client && wrangler deploy --dry-run",
		"generate": "drizzle-kit generate",
		"typecheck": "pnpm run build:client && tsc --noEmit",
		"cf-typegen": "wrangler types",
		"use-drizzle-pr": "bash scripts/use-drizzle-pr.sh"
	},
	"dependencies": {
		"@cloudflare/kumo": "^2.5.2",
		"@phosphor-icons/react": "^2.1.10",
		"drizzle-orm": "file:.drizzle-pr/drizzle-orm/package.tgz",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"drizzle-kit": "file:.drizzle-pr/drizzle-kit/package.tgz",
		"esbuild": "^0.28.1",
		"typescript": "^6.0.3",
		"wrangler": "^4.100.0"
	},
	"packageManager": "pnpm@10.6.4"
}
