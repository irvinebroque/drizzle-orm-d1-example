{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "drizzle-orm-d1-benchmark",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-13",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "drizzle-orm-d1-benchmark",
			"database_id": "e8cfc65f-9732-4261-9d1b-f158d257f1f3",
			"migrations_dir": "drizzle"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "BLOG_DATABASE",
				"class_name": "BlogDatabase"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["BlogDatabase"]
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	}
}
